slam/external/
weights/

# macOS system files
.DS_Store

# VSCode settings (if using)
.vscode/

# Jupyter Notebook checkpoints (if any)
.ipynb_checkpoints/

# Logs and cache
*.log
*.cache

# Local debug output (live session log; never part of a commit)
debug.txt
