# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# uv virtual environment
.venv/

# C++ build artifacts (scikit-build-core's in-tree build dir; the
# vendored third_party sources at native/third_party/ ARE committed)
build/
*.so
*.dylib

# The regenerable/license-restricted trees - ANCHORED to the repo root:
# unanchored patterns exclude same-named directories at ANY depth
# (measured twice: g2o's vendored types/data was excluded here after
# being excluded from the rsync sync for the same reason).
/output/
/videos/
/data/
/weights/
/slam/depth_estimation/
/slam/external/

# Working documents stay local; only the project README is published.
*.md
!README.md

# Probe scripts and local tooling
ui_spikes/

# Test/tool caches and local debug output
.pytest_cache/
.idea/
debug.txt

# macOS system files
.DS_Store

# VSCode settings (if using)
.vscode/

# Jupyter Notebook checkpoints (if any)
.ipynb_checkpoints/

# Logs and cache
*.log
*.cache
